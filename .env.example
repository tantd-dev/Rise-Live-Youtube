# ── LỚP ĐIỀU KHIỂN (máy chủ Next.js) ─────────────────────────────────────
RISE_WORK_LIVE=1                  # bật màn Rise Live
RISE_LIVE_WORKER_TOKEN=           # vé xác thực worker — TỰ SINH chuỗi dài, ngẫu nhiên
RISE_LIVE_LEASE=1                 # BẬT nếu có nhiều hơn 1 máy phát (xem lưu ý 2 ở README)
RISE_LIVE_AUTOFAILOVER=1          # tự chuyển luồng khi máy chết
RISE_LIVE_FAILOVER_OFFLINE_SEC=60 # bao lâu không thấy nhịp tim thì coi máy là chết
RISE_LIVE_FAILOVER_OFF=           # công tắc TẮT KHẨN cơ chế tự cứu (để trống = đang bật)
RISE_LIVE_REALTIME=1              # đẩy cập nhật về giao diện qua SSE
RISE_LIVE_THUMB_PUSH_SEC=1200     # nhịp máy phát đẩy ảnh xem-trước về máy chủ
RISE_LIVE_MIN_FREE_GB=            # dưới mức này thì cảnh báo hết đĩa
RISE_LIVE_REPLICAS_PRIORITY=      # số bản sao cho luồng ưu tiên
RISE_LIVE_REPLICAS_CRITICAL=      # số bản sao cho luồng trọng yếu

# Nối YouTube (không bắt buộc — thiếu thì không tạo buổi phát tự động được)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
RISE_YT_API_KEY=

# Gửi email cảnh báo (không bắt buộc)
RESEND_API_KEY=
EMAIL_FROM=no-reply@<TEN-MIEN-CUA-BAN>
RISE_LIVE_ALERT_EMAILS=

# ── MỖI VPS PHÁT (đặt trong systemd unit, KHÔNG đặt ở máy chủ) ───────────
# ⚠️ RISE_LIVE_URL: ĐỪNG trỏ về máy chủ Rise Work đang chạy thật — worker sẽ
#    giành mất quyền phát của các luồng thật và làm chúng tắt.
# RISE_LIVE_URL=https://<DIA-CHI-MAY-CHU-CUA-BAN>
# RISE_LIVE_TOKEN=<trùng với RISE_LIVE_WORKER_TOKEN ở trên>
# RISE_LIVE_MACHINE=<mã máy lấy từ giao diện Rise Live>
# RISE_LIVE_UPLOAD_PORT=8099
# RISE_LIVE_UPLOAD_TOKEN=
# RISE_LIVE_MAX_ENCODE=
# RISE_LIVE_MAX_PARALLEL_DOWNLOADS=
