# Sao chép thành .env.local rồi sửa. KHÔNG commit .env.local.

# --- Bật Rise Live + xác thực worker ---
RISE_WORK_LIVE=1
RISE_LIVE_WORKER_TOKEN=doi-thanh-mot-chuoi-ngau-nhien-that-dai
RISE_LIVE_LEASE=1

# --- Firestore giả lập trên máy (không cần Firebase thật) ---
GOOGLE_CLOUD_PROJECT=demo-rise-live
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Đăng nhập thử. Chỉ hoạt động khi có FIRESTORE_EMULATOR_HOST ---
ALLOW_DEV_LOGIN=1
DEV_LOGIN_EMAIL=dev@local.test

# --- Địa chỉ app (dùng cho link trong email / OAuth) ---
APP_BASE_URL=http://localhost:3000

# --- Bí mật cho 2 cron endpoint (failover / alerts). .env.example gốc đang thiếu biến này ---
REPORT_REMINDER_SECRET=doi-thanh-chuoi-ngau-nhien
